# go-multi-warp Dokploy / docker-compose env
# Paste these into Dokploy Environment, or copy to .env

# --- Core ---
MULTI_WARP_MODE=managed
# Number of warp-svc instances (default 10). For unique IPv4 prefer 1 license per instance.
WARP_INSTANCES=10
MULTI_WARP_INSTANCES=10
MULTI_WARP_STRATEGY=round_robin

# Proxy listeners (host publish maps to these)
MULTI_WARP_SOCKS=0.0.0.0:11080
MULTI_WARP_HTTP=0.0.0.0:18080
MULTI_WARP_ADMIN=0.0.0.0:9090

# Proxy auth + limits
PROXY_USER=user
PROXY_PASS=pass
PROXY_MAX_CONN=1000

# --- Multi-key (required for unique IPv4) ---
# Put N distinct WARP+ license keys separated by comma.
# Instance i uses keys[i % N]. For 10 unique IPs set WARP_INSTANCES=10 and 10 keys.
# Example:
# WARP_LICENSE_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
WARP_LICENSE_KEYS=

# Optional single-key alias (same as WARP_LICENSE_KEYS with 1 entry)
# WARP_LICENSE_KEY=

# Force re-register all instances (set true once after changing keys, then redeploy, then set false)
MULTI_WARP_FORCE_REREGISTER=false

# --- Progressive unique IPv4 (best-effort, NOT guaranteed) ---
# First healthy instance serves immediately.
# Later instances re-register until egress IPv4 is unique vs current pool, with attempt cap.
# Safer re-reg: concurrent cap + stagger + exponential backoff.
# Post-admit recheck: de-dupe collisions in background without dropping capacity.
# Effort only runs when instances <= MULTI_WARP_UNIQUE_IPV4_MAX (default 20).
MULTI_WARP_UNIQUE_IPV4=true
MULTI_WARP_UNIQUE_IPV4_MAX=20
MULTI_WARP_UNIQUE_ATTEMPTS=8
MULTI_WARP_UNIQUE_PROBE_URL=https://api.ipify.org
# false = after attempts exhausted still admit (concurrency > purity)
# true  = park non-unique backends out of the selector
MULTI_WARP_UNIQUE_STRICT=false
MULTI_WARP_UNIQUE_BACKOFF_MS=8000
MULTI_WARP_UNIQUE_MAX_CONCURRENT_REG=2
MULTI_WARP_UNIQUE_STAGGER_MS=3000
MULTI_WARP_UNIQUE_RECHECK_MS=60000
MULTI_WARP_UNIQUE_RECHECK_MAX=3

# WARP Teams / MDM (mutually exclusive with WARP_LICENSE_KEYS)
# WARP_ORG=
# WARP_AUTH_CLIENT_ID=
# WARP_AUTH_CLIENT_SECRET=

RUST_LOG=info
